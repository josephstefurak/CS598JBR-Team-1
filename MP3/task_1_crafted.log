import java.util.*;
import java.lang.*;

class Solution {
    public static List<String> sortedListSum(List<String> lst) {
        lst.sort(Comparator.naturalOrder());
        List<String> newLst = new ArrayList<>();
        for (String i : lst) {
            if (i.length() % 2 == 0) {
                newLst.add(i);
            }
        }
        newLst.sort(Comparator.comparing(String::length));
        return newLst;
    }
}
