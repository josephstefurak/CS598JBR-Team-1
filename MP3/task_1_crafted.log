public static Integer[] sortArray(Integer[] array) {
    if (array.length == 0) {
        return new Integer[0];
    } else {
        Integer[] sortedArray = Arrays.copyOf(array, array.length);
        boolean isEvenSum = (sortedArray[0] + sortedArray[sortedArray.length - 1]) % 2 == 0;
        if (isEvenSum) {
            Arrays.sort(sortedArray, Collections.reverseOrder());
        } else {
            Arrays.sort(sortedArray);
        }
        return sortedArray;
    }
}

