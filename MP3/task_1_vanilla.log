            add(2);
            add(4);
            add(1);
            add(3);
            add(5);
            add(7);
        }}));
    }

    public static Pair<Integer, Integer> largest_smallest_integers(ArrayList<Integer> lst) {
        ArrayList<Integer> smallest = new ArrayList<>();
        ArrayList<Integer> largest = new ArrayList<>();

        for (Integer num : lst) {
            if (num < 0) {
                smallest.add(num);
            } else if (num > 0) {
                largest.add(num);
            }
        }

        if (smallest.isEmpty()) {
            return new Pair<>(null, null);
        } else if (largest.isEmpty()) {
            return new Pair<>(Collections.max(smallest), null);
        } else {
            return new Pair<>(Collections.max(smallest), Collections.min(largest));
        }
    }

    static class Pair<T1, T2> {
        T1 first;
        T2 second;

        public Pair(T1 first, T2 second) {
            this.first = first;
            this.second = second;
        }

        @Override
        public String toString() {
            return "Pair{" +
                    "first=" + first +
                    ", second=" + second +
                    '}';
        }
    }
}
```

