def fix_spaces(text):
    """
    Given a string text, replace all spaces in it with underscores, 
    and if a string has more than 2 consecutive spaces, 
    then replace all consecutive spaces with - 
    
    fix_spaces("Example") == "Example"
    fix_spaces("Example 1") == "Example_1"
    fix_spaces(" Example 2") == "_Example_2"
    fix_spaces(" Example   3") == "_Example-3"
    """
    new_text = ""
    i = 0
    start, end = 0, 0
    while i < len(text):
        if text[i] == " ":
            end += 1
        else:
            if end - start > 2:
                new_text += "-"+text[i]
            elif end - start > 0:
                new_text += "_"*(end - start)+text[i]
            else:
                new_text += text[i]
            start, end = i+1, i+1
        i+=1
    if end - start > 2:
        new_text += "-"
    elif end - start > 0:
        new_text += "_"
    return new_text


### Response:

response:
Sure, here is the Java version of your Python code:

```java
public class Main {
    public static void main(String[] args) {
        System.out.println(fixSpaces("Example"));
        System.out.println(fixSpaces("Example 1"));
        System.out.println(fixSpaces(" Example 2"));
        System.out.println(fixSpaces(" Example   3"));
    }

    public static String fixSpaces(String text) {
        StringBuilder newText = new StringBuilder();
        int i = 0;
        int start = 0, end = 0;
        while (i < text.length()) {
            if (text.charAt(i) == ' ') {
                end++;
            } else {
                if (end - start > 2) {
                    newText.append("-").append(text.charAt(i));
                } else if (end - start > 0) {
                    newText.append(text.substring(start, end).replace(" ", "_"))
                           .append(text.charAt(i));
                } else {
                    newText.append(text.charAt(i));
                }
                start = end = i+1;
            }
            i++;
        }
        if (end - start > 2) {
            newText.append("-");
        } else if (end - start > 0) {
            newText.append(text.substring(start, end).replace(" ", "_"));
        }
        return newText.toString();
    }
}
```

This Java code does the same thing as your Python code. It replaces all spaces in a string with underscores, and if there are more than two consecutive spaces, it replaces all consecutive spaces with a dash. The `fixSpaces` function takes a string as input and returns a new string with the replacements made. The `main` function is used to test the `fixSpaces` function with different inputs.

